{
    "manifest_version": 3,
    "name": "DarkPattern Shield",
    "version": "1.0.0",
    "description": "Mendeteksi dan menyorot checkbox jebakan opt-in serta biaya tersembunyi secara otomatis.",
    "permissions": ["activeTab"],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ]
}
